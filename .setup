#!/bin/csh
# ../clon/.setup
#

if ($?CLAS) then
    setenv CLON $CLAS/clon
else
    echo "CLAS environment variable does not defined !!!"o
    exit 1
endif


setenv CLON_BIN   ${CLON}/${OSTYPE_MACHINE}/bin
setenv CLON_LIB   ${CLON}/${OSTYPE_MACHINE}/lib
setenv CLON_PARMS ${CLAS}/parms

if ($?LD_LIBRARY_PATH) then
  setenv LD_LIBRARY_PATH  "${LD_LIBRARY_PATH}:${CLON_LIB}"
else
  setenv LD_LIBRARY_PATH  ${CLON_LIB}
endif

setenv PATH "${PATH}:${CLON_BIN}"
setenv PATH "${PATH}:${CLON}/common/scripts"


